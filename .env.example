# Environment example for running hackatime in Gitpod
# Copy this into .env or set the values in Gitpod's Environment Variables UI.

# Database configurations - with Gitpod you can use a hosted Postgres or a local DB
# Example (if you use a Gitpod Postgres plugin or external DB):
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/app_development
# SAILORS_LOG_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/app_development

# Generate these with `rails secret` or use the generator commands shown in the Gitpod setup notes
SECRET_KEY_BASE=REPLACE_ME
ENCRYPTION_PRIMARY_KEY=REPLACE_ME
ENCRYPTION_DETERMINISTIC_KEY=REPLACE_ME
ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_ME

# Hack Club Account (create this in https://hca.dinosaurbbq.org - enable Developer Mode and create an app)
HCA_CLIENT_ID=REPLACE_ME
HCA_CLIENT_SECRET=REPLACE_ME

# Note: Do NOT commit secrets into your repo. Use Gitpod's Environment Variables to store them securely.
